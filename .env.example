# Скопируй этот файл в .env и заполни значения
# cp .env.example .env

# Discord Bot Token (получить на https://discord.com/developers/applications)
TOKEN=YOUR_DISCORD_BOT_TOKEN_HERE

# MongoDB connection string (пример: mongodb+srv://user:pass@cluster.mongodb.net/dbname)
MONGODB=YOUR_MONGODB_CONNECTION_STRING_HERE